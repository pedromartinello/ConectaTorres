NODE_ENV=development
PORTA=3001
FRONTEND_URL=http://localhost:5173
# Opcional: outras origens permitidas pelo CORS, separadas por vírgula.
FRONTEND_URLS_ADICIONAIS=
FUSO_HORARIO=America/Sao_Paulo

# Banco local. Em produção no Railway, prefira DATABASE_URL.
DATABASE_URL=
BANCO_HOST=localhost
BANCO_PORTA=5432
BANCO_NOME=conectatorres
BANCO_USUARIO=conectatorres
BANCO_SENHA=sua_senha_do_banco
BANCO_SSL=false

# Em produção use uma chave aleatória com pelo menos 48 caracteres.
JWT_SEGREDO=gere_uma_chave_secreta_e_segura
JWT_EXPIRACAO=8h

# Em produção com frontend e backend em domínios diferentes (vercel.app + railway.app), use none.
COOKIE_SAMESITE=lax
COOKIE_DOMINIO=

# Em produção no Railway, aponte para o volume persistente, por exemplo /dados/uploads.
UPLOAD_DIRETORIO=

ADMIN_NOME=Administrador ConectaTorres
ADMIN_EMAIL=admin@conectatorres.local
ADMIN_SENHA=defina_uma_senha_segura

RECUPERACAO_SENHA_MINUTOS=30
RECUPERACAO_EXIBIR_LINK=true
CONFIRMACAO_EMAIL_HORAS=24

# E-mail em produção: API HTTPS da Brevo (recomendado no Railway Free/Trial/Hobby).
BREVO_API_KEY=
EMAIL_REMETENTE_NOME=ConectaTorres
EMAIL_REMETENTE=seu_email_verificado@gmail.com
EMAIL_REPLY_TO=seu_email_verificado@gmail.com

# SMTP permanece disponível como fallback para desenvolvimento local ou Railway Pro.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
SMTP_SEGURO=true
SMTP_USUARIO=seu_email@gmail.com
SMTP_SENHA=sua_senha_de_app

IA_HABILITADA=true
OPENAI_API_KEY=sua_chave_da_api
OPENAI_MODELO=gpt-5.6-terra
